{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"fluid": false,
	"installCommand": "echo sin-instalacion",
	"buildCommand": "echo sin-build",
	"outputDirectory": "public",
	"functions": {
		"api/index.php": {
			"runtime": "vercel-php@0.9.0",
			"maxDuration": 60,
			"excludeFiles": "{.git/**,.github/**,.claude/**,.impeccable/**,.devtools/**,.vscode/**,docs/**,captures/**,scratch/**,tests/**,test-results/**,DailyFotos/**,mobile/**,references/**,changelog/**,data/**,node_modules/**,public/packages/**,public/img/**,*.png,*.md,package-lock.json,yarn.lock}"
		}
	},
	"routes": [
		{ "src": "/", "dest": "/api/index.php" },
		{ "src": "/(.*)\\.php$", "dest": "/api/index.php" },
		{ "handle": "filesystem" },
		{ "src": "/(.*)", "dest": "/api/index.php" }
	]
}
