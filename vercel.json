{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "echo sin-instalacion",
	"buildCommand": "echo sin-build",
	"outputDirectory": "public",
	"functions": {
		"api/index.php": {
			"runtime": "vercel-php@0.9.0",
			"memory": 1024,
			"maxDuration": 60,
			"includeFiles": "{app.php,config-dist.php,routes.php,version.json,grocy.openapi.json,controllers/**,services/**,helpers/**,middleware/**,views/**,localization/**,migrations/**,packages/**,plugins/**,vercel/**}"
		}
	},
	"routes": [
		{ "src": "/", "dest": "/api/index.php" },
		{ "src": "/(.*)\\.php$", "dest": "/api/index.php" },
		{ "handle": "filesystem" },
		{ "src": "/(.*)", "dest": "/api/index.php" }
	]
}
